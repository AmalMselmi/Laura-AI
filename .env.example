# Copy to .env and adjust. Used by docker compose and local tooling.
#
# Docker Desktop: the stack appears as project "laura-ai" (see `name:` in docker-compose.yml).
# When Hub is reachable: `docker compose pull` then `docker compose up --build`.

# --- Postgres (docker-compose defaults) ---
POSTGRES_USER=laura
POSTGRES_PASSWORD=laura
POSTGRES_DB=laura_ai
# Host port for Laura DB (5432 is often taken by another Postgres container)
POSTGRES_PUBLISH_PORT=5433

# --- Prisma Studio / db pull (optional; native URL, no +psycopg2) ---
# Example when Postgres is on localhost (e.g. port-forward from Docker):
# PRISMA_DATABASE_URL=postgresql://laura:laura@127.0.0.1:5432/laura_ai

# --- API / worker ---
DATABASE_URL=postgresql+psycopg2://laura:laura@db:5432/laura_ai
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string

APP_ENV=production
APP_DEBUG=false
REFRESH_COOKIE_SECURE=false
# URL prefix for all API routers (default /api). Leave unset; an empty value is normalized to /api so /api/health works for the SPA.
# API_PREFIX=/api

# Comma-separated browser origins (CORS)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Frontend build (docker compose build args) ---
VITE_API_URL=http://localhost:8000

# --- S3 / MinIO (optional; leave empty for local disk uploads) ---
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- OpenAI (optional; scan falls back to mock analysis without key) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- SMTP (optional; reserved for notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Feature flags ---
ENABLE_PACS_INTEGRATION=true
ENABLE_AI_SCAN=true
MAX_UPLOAD_MB=50

# --- Published ports ---
HTTP_PORT=80
API_PORT=8000
