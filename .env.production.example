# Production-style values for Laura AI (Docker Compose).
# Copy to .env on the server and replace secrets.

POSTGRES_USER=laura
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=laura_ai

DATABASE_URL=postgresql+psycopg2://laura:REPLACE_WITH_STRONG_PASSWORD@db:5432/laura_ai
REDIS_URL=redis://redis:6379/0

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

APP_ENV=production
APP_DEBUG=false
REFRESH_COOKIE_SECURE=true

# Public site URL(s) actually used by browsers (HTTPS in real prod)
ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# If the SPA is served from the same host and nginx proxies /api, set:
# VITE_API_URL=https://app.example.com
# If the API is on a separate subdomain:
# VITE_API_URL=https://api.example.com
VITE_API_URL=https://api.example.com

S3_BUCKET=laura-prod
S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME

OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-4o-mini

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

ENABLE_PACS_INTEGRATION=true
ENABLE_AI_SCAN=true
MAX_UPLOAD_MB=50

HTTP_PORT=80
API_PORT=8000
